@mode(host.dual)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "cut";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Remove sections from each line of files (a Loup recreation of GNU cut).";

# Exit statuses returned by main(). GNU cut reports usage errors with 1,
# the same status as a file it cannot read.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 1;
