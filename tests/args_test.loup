@mode(host.dual)

# Unit tests for cut's argument parsing (cli.args): defaults, the three
# modes, delimiters, flags and files, --help and --version, and the usage
# errors in GNU's order.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test`, source/ on LOUPPATH), one test
# per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (Mode, Options, parse_args, nul);

func parse(argv: list[string]): Options {
    return parse_args(argv).unwrap();
}

func error_of(argv: list[string]): string {
    return parse_args(argv).unwrap_err();
}

func test_fields_defaults(): void {
    let opts = parse(["-f", "2"]);
    expect(opts.mode == Mode.Fields, "fields");
    expectEq(opts.delimiter, "\t", "TAB delimiter");
    expectEq(opts.output_delimiter, "\t", "output follows input");
    expect(!opts.explicit_output_delimiter, "not explicit");
    expect(!opts.only_delimited, "no -s");
    expectEq(opts.terminator, "\n", "newline");
    expectEq(opts.files.len(), 0, "no files");
}

func test_modes(): void {
    expect(parse(["-b1"]).mode == Mode.Bytes, "-b");
    expect(parse(["-c1"]).mode == Mode.Characters, "-c");
    expect(parse(["--characters=1"]).mode == Mode.Characters, "--characters");
}

func test_delimiters(): void {
    let opts = parse(["-d:", "-f1", "--output-delimiter", " | "]);
    expectEq(opts.delimiter, ":", "-d");
    expectEq(opts.output_delimiter, " | ", "--output-delimiter");
    expect(opts.explicit_output_delimiter, "explicit");
    expectEq(parse(["-d", "", "-f1"]).delimiter, nul(), "empty -d is NUL");
    expectEq(parse(["--output-delimiter=", "-f1"]).output_delimiter, nul(), "empty output delimiter is NUL");
    expectEq(parse(["-d", "é", "-f1"]).delimiter, "é", "multibyte delimiter");
}

func test_flags_and_files(): void {
    let opts = parse(["a.txt", "-sf", "1", "-z", "-n", "-", "--complement"]);
    expect(opts.only_delimited, "-s");
    expectEq(opts.terminator, nul(), "-z");
    expectEq(opts.files.len(), 2, "two files");
    expectEq(opts.files[1], "-", "dash");
    expectEq(opts.ranges.len(), 1, "complemented");
    expectEq(opts.ranges[0].lo, 2, "from 2");
}

func test_help_and_version(): void {
    expect(parse(["--help"]).help, "--help");
    expect(parse(["--version"]).version, "--version");
    expect(parse(["--he", "-x"]).help, "abbreviated, before an error");
    expect(parse(["-f0", "--help"]).help, "LIST errors come after --help");
}

func test_usage_errors(): void {
    let none: list[string] = [];
    expectEq(error_of(none), "you must specify a list of bytes, characters, or fields", "no list");
    expectEq(error_of(["-f1", "-f2"]), "only one list may be specified", "two lists");
    expectEq(error_of(["-c1", "-d:"]), "an input delimiter may be specified only when operating on fields", "-d without -f");
    expectEq(error_of(["-b1", "-s"]), "suppressing non-delimited lines makes sense\n\tonly when operating on fields", "-s without -f");
    expectEq(error_of(["-d", "ab", "-f1"]), "the delimiter must be a single character", "long delimiter");
    expectEq(error_of(["-f", "x"]), "invalid field value 'x'", "bad list");
    expectEq(error_of(["-q"]), "invalid option -- 'q'", "unknown option");
}
